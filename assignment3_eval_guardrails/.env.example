# Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=            # MediBot (target, Sonnet 5.5), OpenEvals guardrails (Haiku 4.5), RAGAS and judge (Opus 5.5)
LANGSMITH_API_KEY=            # tracing; leave empty to run without traces
LANGSMITH_PROJECT=mediguard-assignment3
AWS_REGION=us-east-1          # Bedrock Guardrails (falls back to AWS_DEFAULT_REGION); credentials from `aws login` / your profile
BEDROCK_GUARDRAIL_ID=         # printed by `make guardrail-setup`; without it, run with ARGS="--no-bedrock"
BEDROCK_GUARDRAIL_VERSION=    # printed by `make guardrail-setup`; empty means DRAFT
# Optional
# MEDIGUARD_HOME=~/.cache/mediguard        # caches, runs, logs, venv (kept outside the repo)
# MEDIGUARD_TARGET_MODEL=claude-sonnet-5-5
# MEDIGUARD_JUDGE_MODEL=claude-opus-5-5
# MEDIGUARD_JUDGE_EFFORT=medium
# MEDIGUARD_GUARD_MODEL=claude-haiku-4-5   # OpenEvals input/output judges
# MEDIGUARD_RAGAS_MODEL=claude-opus-5-5    # RAGAS evaluator
# MEDIGUARD_TRACING=1                      # 0 turns LangSmith off even with a key
# MEDIGUARD_REPLAY=replay                  # replay | fresh | replay_only
# MEDIGUARD_BUDGET_USD=20                  # an eval run stops before RAGAS / the judge once it has spent more
